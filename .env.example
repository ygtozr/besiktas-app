# Sunucu ortam değişkenleri. Gerçek değerler Vercel → Settings → Environment Variables'a girilir.
# Bu dosya örnektir; gerçek .env git'e girmez.

# Türkiye Kupası için (isteğe bağlı). Yoksa uygulama kupa uyarısı gösterir.
# API_FOOTBALL_KEY=

# Günlük API-Football istek sınırı. Ücretsiz plan 100; güvenlik payı için 90.
# API_FOOTBALL_DAILY_LIMIT=90
